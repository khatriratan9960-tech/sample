{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "php-api/data/**"
    }
  },
  "crons": [
    { "path": "/api/cron/sync-results", "schedule": "* * * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}